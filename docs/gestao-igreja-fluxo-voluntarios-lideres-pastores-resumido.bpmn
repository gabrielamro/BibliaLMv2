        <dc:Bounds x="1470" y="565" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ConviteAceito_di" bpmnElement="Gateway_ConviteAceito" isMarkerVisible="true">
        <dc:Bounds x="1665" y="580" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_ConviteRecusado_di" bpmnElement="EndEvent_ConviteRecusado">
