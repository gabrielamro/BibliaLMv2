      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_SalvarLideranca_di" bpmnElement="ServiceTask_SalvarLideranca">
        <dc:Bounds x="2160" y="265" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReceberEquipe_di" bpmnElement="Task_ReceberEquipe">
        <dc:Bounds x="2360" y="415" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CriarDesignacao_di" bpmnElement="Task_CriarDesignacao">
        <dc:Bounds x="2550" y="415" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_ValidarVagas_di" bpmnElement="ServiceTask_ValidarVagas">
        <dc:Bounds x="2750" y="265" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_HaVagaDisponivel_di" bpmnElement="Gateway_HaVagaDisponivel" isMarkerVisible="true">
        <dc:Bounds x="2945" y="280" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AjustarEquipeOuLideranca_di" bpmnElement="Task_AjustarEquipeOuLideranca">
        <dc:Bounds x="3030" y="115" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReceberDesignacao_di" bpmnElement="Task_ReceberDesignacao">
        <dc:Bounds x="3030" y="565" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ResponderDesignacao_di" bpmnElement="Task_ResponderDesignacao">
        <dc:Bounds x="3220" y="565" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_DesignacaoAceita_di" bpmnElement="Gateway_DesignacaoAceita" isMarkerVisible="true">
        <dc:Bounds x="3425" y="580" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_ConfirmarDesignacao_di" bpmnElement="ServiceTask_ConfirmarDesignacao">
        <dc:Bounds x="3510" y="265" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_LiberarVaga_di" bpmnElement="ServiceTask_LiberarVaga">
        <dc:Bounds x="3510" y="565" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EscolherOutroVoluntario_di" bpmnElement="Task_EscolherOutroVoluntario">
        <dc:Bounds x="3710" y="415" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AcompanharEquipe_di" bpmnElement="Task_AcompanharEquipe">
