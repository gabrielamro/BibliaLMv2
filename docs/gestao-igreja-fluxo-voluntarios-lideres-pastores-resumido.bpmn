<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_GestaoIgreja_VoluntariosLideresPastores_Resumido"
                  targetNamespace="https://biblialm.com.br/bpmn/gestao-igreja/voluntarios-lideres-pastores">
  <bpmn:process id="Process_GestaoIgreja_VoluntariosLideresPastores_Resumido"
                name="Gestao da Igreja - Voluntarios, Lideres e Pastores - Resumido"
                isExecutable="true">
    <bpmn:documentation>
      Fluxo resumido do modulo Gestao da Igreja focado em voluntarios, lideres e pastores.
      Escopo: criacao de equipes, vinculo de voluntarios, atribuicao de lideranca, designacoes com vagas e acompanhamento pastoral.
      Fora do escopo deste fluxo: aprovacao inicial da plataforma, QR Code, captacao externa, Inbox e Minha Igreja.
      Para execucao real em motor BPMN, configurar formularios, assignees, expressoes dos gateways e workers das service tasks.
    </bpmn:documentation>

    <bpmn:laneSet id="LaneSet_GestaoIgreja_Resumo">
      <bpmn:lane id="Lane_GestorIgreja" name="Gestor da Igreja">
        <bpmn:flowNodeRef>StartEvent_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AcessarGestao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CriarEquipe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConvidarVoluntarios</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DefinirLideranca</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AjustarEquipeOuLideranca</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Sistema" name="Sistema BibliaLM">
        <bpmn:flowNodeRef>ServiceTask_ValidarPermissaoGestao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TemPermissaoGestao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_AcessoNegado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_SalvarEquipe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_RegistrarConvites</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_AtivarVoluntario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_SalvarLideranca</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_ValidarVagas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HaVagaDisponivel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_ConfirmarDesignacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_LiberarVaga</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_AtualizarIndicadores</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_LiderPastor" name="Lider / Pastor">
        <bpmn:flowNodeRef>Task_ReceberEquipe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CriarDesignacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EscolherOutroVoluntario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AcompanharEquipe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AcompanharVisaoPastoral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Fim</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Voluntario" name="Voluntario">
        <bpmn:flowNodeRef>Task_AceitarConvite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ConviteAceito</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ConviteRecusado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceberDesignacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResponderDesignacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DesignacaoAceita</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Inicio" name="Inicio">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_AcessarGestao" name="Acessar Gestao da Igreja">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ServiceTask_ValidarPermissaoGestao" name="Validar permissao de gestao">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_TemPermissaoGestao" name="Tem permissao?">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04_Sim</bpmn:outgoing>
      <bpmn:outgoing>Flow_04_Nao</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_AcessoNegado" name="Acesso negado">
      <bpmn:incoming>Flow_04_Nao</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_CriarEquipe" name="Criar equipe ou ministerio">
      <bpmn:incoming>Flow_04_Sim</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ServiceTask_SalvarEquipe" name="Salvar equipe">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_ConvidarVoluntarios" name="Convidar ou vincular voluntarios">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ServiceTask_RegistrarConvites" name="Registrar vinculos pendentes">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_AceitarConvite" name="Aceitar ou recusar convite">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_ConviteAceito" name="Convite aceito?">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10_Sim</bpmn:outgoing>
      <bpmn:outgoing>Flow_10_Nao</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_ConviteRecusado" name="Convite recusado">
      <bpmn:incoming>Flow_10_Nao</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="ServiceTask_AtivarVoluntario" name="Ativar voluntario na equipe">
      <bpmn:incoming>Flow_10_Sim</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_DefinirLideranca" name="Definir lider ou pastor responsavel">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ServiceTask_SalvarLideranca" name="Salvar permissao de lideranca">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_ReceberEquipe" name="Receber acesso a equipe">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_CriarDesignacao" name="Criar designacao com vagas">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ServiceTask_ValidarVagas" name="Validar vagas disponiveis">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_HaVagaDisponivel" name="Ha vaga?">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17_Sim</bpmn:outgoing>
      <bpmn:outgoing>Flow_17_Nao</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_AjustarEquipeOuLideranca" name="Ajustar equipe, vagas ou lideranca">
      <bpmn:incoming>Flow_17_Nao</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ReceberDesignacao" name="Receber designacao">
      <bpmn:incoming>Flow_17_Sim</bpmn:incoming>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ResponderDesignacao" name="Aceitar ou recusar designacao">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_DesignacaoAceita" name="Designacao aceita?">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20_Sim</bpmn:outgoing>
      <bpmn:outgoing>Flow_20_Nao</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="ServiceTask_ConfirmarDesignacao" name="Confirmar vaga e agenda">
      <bpmn:incoming>Flow_20_Sim</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ServiceTask_LiberarVaga" name="Liberar vaga recusada">
      <bpmn:incoming>Flow_20_Nao</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_EscolherOutroVoluntario" name="Escolher outro voluntario">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_AcompanharEquipe" name="Acompanhar escala e presenca">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ServiceTask_AtualizarIndicadores" name="Atualizar indicadores da equipe">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_AcompanharVisaoPastoral" name="Acompanhar visao pastoral">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Fim" name="Fluxo operacional acompanhado">
      <bpmn:incoming>Flow_27</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:textAnnotation id="TextAnnotation_RegrasResumo">
      <bpmn:text>Regras principais: gestor administra equipes e permissoes; lider atua somente nas equipes sob sua responsabilidade; pastor possui visao pastoral ampla; voluntario ve e responde apenas suas proprias designacoes; designacao deve respeitar quantidade de vagas.</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:association id="Association_RegrasResumo" sourceRef="Gateway_HaVagaDisponivel" targetRef="TextAnnotation_RegrasResumo" />

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Inicio" targetRef="Task_AcessarGestao" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_AcessarGestao" targetRef="ServiceTask_ValidarPermissaoGestao" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="ServiceTask_ValidarPermissaoGestao" targetRef="Gateway_TemPermissaoGestao" />
    <bpmn:sequenceFlow id="Flow_04_Sim" name="Sim" sourceRef="Gateway_TemPermissaoGestao" targetRef="Task_CriarEquipe" />
    <bpmn:sequenceFlow id="Flow_04_Nao" name="Nao" sourceRef="Gateway_TemPermissaoGestao" targetRef="EndEvent_AcessoNegado" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_CriarEquipe" targetRef="ServiceTask_SalvarEquipe" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="ServiceTask_SalvarEquipe" targetRef="Task_ConvidarVoluntarios" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_ConvidarVoluntarios" targetRef="ServiceTask_RegistrarConvites" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="ServiceTask_RegistrarConvites" targetRef="Task_AceitarConvite" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_AceitarConvite" targetRef="Gateway_ConviteAceito" />
    <bpmn:sequenceFlow id="Flow_10_Sim" name="Sim" sourceRef="Gateway_ConviteAceito" targetRef="ServiceTask_AtivarVoluntario" />
    <bpmn:sequenceFlow id="Flow_10_Nao" name="Nao" sourceRef="Gateway_ConviteAceito" targetRef="EndEvent_ConviteRecusado" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="ServiceTask_AtivarVoluntario" targetRef="Task_DefinirLideranca" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_DefinirLideranca" targetRef="ServiceTask_SalvarLideranca" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="ServiceTask_SalvarLideranca" targetRef="Task_ReceberEquipe" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_ReceberEquipe" targetRef="Task_CriarDesignacao" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_CriarDesignacao" targetRef="ServiceTask_ValidarVagas" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="ServiceTask_ValidarVagas" targetRef="Gateway_HaVagaDisponivel" />
    <bpmn:sequenceFlow id="Flow_17_Sim" name="Sim" sourceRef="Gateway_HaVagaDisponivel" targetRef="Task_ReceberDesignacao" />
    <bpmn:sequenceFlow id="Flow_17_Nao" name="Nao" sourceRef="Gateway_HaVagaDisponivel" targetRef="Task_AjustarEquipeOuLideranca" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_ReceberDesignacao" targetRef="Task_ResponderDesignacao" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_ResponderDesignacao" targetRef="Gateway_DesignacaoAceita" />
    <bpmn:sequenceFlow id="Flow_20_Sim" name="Sim" sourceRef="Gateway_DesignacaoAceita" targetRef="ServiceTask_ConfirmarDesignacao" />
    <bpmn:sequenceFlow id="Flow_20_Nao" name="Nao" sourceRef="Gateway_DesignacaoAceita" targetRef="ServiceTask_LiberarVaga" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="ServiceTask_ConfirmarDesignacao" targetRef="Task_AcompanharEquipe" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="ServiceTask_LiberarVaga" targetRef="Task_EscolherOutroVoluntario" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_AjustarEquipeOuLideranca" targetRef="Task_CriarDesignacao" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_EscolherOutroVoluntario" targetRef="Task_ReceberDesignacao" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_AcompanharEquipe" targetRef="ServiceTask_AtualizarIndicadores" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="ServiceTask_AtualizarIndicadores" targetRef="Task_AcompanharVisaoPastoral" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_AcompanharVisaoPastoral" targetRef="EndEvent_Fim" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_GestaoIgreja_Resumo">
    <bpmndi:BPMNPlane id="BPMNPlane_GestaoIgreja_Resumo" bpmnElement="Process_GestaoIgreja_VoluntariosLideresPastores_Resumido">
      <bpmndi:BPMNShape id="Lane_GestorIgreja_di" bpmnElement="Lane_GestorIgreja" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="4600" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Sistema_di" bpmnElement="Lane_Sistema" isHorizontal="true">
        <dc:Bounds x="120" y="230" width="4600" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_LiderPastor_di" bpmnElement="Lane_LiderPastor" isHorizontal="true">
        <dc:Bounds x="120" y="380" width="4600" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Voluntario_di" bpmnElement="Lane_Voluntario" isHorizontal="true">
        <dc:Bounds x="120" y="530" width="4600" height="150"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_Inicio_di" bpmnElement="StartEvent_Inicio">
        <dc:Bounds x="180" y="137" width="36" height="36"/>
      </bpmndi:BPMNShape>
